# ---------------------------------------------------------------------------
# Mode. Paper trading is the default. Live trading needs BOTH lines below.
# ---------------------------------------------------------------------------
DRY_RUN=true
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THIS_USES_REAL_MONEY
PAPER_BANKROLL_USD=500

# ---------------------------------------------------------------------------
# Wallet (live only). Use a dedicated hot wallet holding only test funds.
# NEVER commit a filled-in .env file.
# ---------------------------------------------------------------------------
# Private key of the signer that controls your Polymarket account wallet.
POLYMARKET_PRIVATE_KEY=
# Your Polymarket account wallet address (profile menu on polymarket.com).
# Leave empty to use the signer's default Deposit Wallet.
POLYMARKET_WALLET_ADDRESS=
# Optional gasless API key: lets the bot set up approvals and AUTO-REDEEM winning shares.
# Without one, winners are kept in state.json "pending_redeem" (still counted in the bankroll) and the
# log says once per position to claim them in the Polymarket UI (Polymarket often auto-claims anyway).
# Use EITHER a Relayer key (key + address) ...
#   polymarket.com > Settings > API Keys > Relayer API Keys
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
# ... OR a Builder key (all three values; takes precedence if complete).
#   (from your Polymarket builder profile; the Relayer key above is simpler for a personal bot)
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=
# Try to auto-redeem when a key is set, and how often to retry a failed redeem (seconds).
AUTO_REDEEM=true
REDEEM_RETRY_SECONDS=300

# ---------------------------------------------------------------------------
# Strategy (see README "Backtest findings")
# ---------------------------------------------------------------------------
STRATEGY=favorite
FAV_DURATIONS=15m
FAV_MIN_SECS_LEFT=600
FAV_MAX_SECS_LEFT=900
FAV_MIN_PRICE=0.85
FAV_MAX_PRICE=0.95
FAV_EDGE_EST=0.015
ARB_ENABLED=true
ARB_MIN_EDGE=0.01
ARB_MAX_USD=10
USE_NEWS_IN_MODEL=false

# ---------------------------------------------------------------------------
# Model-strategy thresholds (STRATEGY=model only)
# ---------------------------------------------------------------------------
MIN_MODEL_PROB=0.80
MIN_EDGE=0.07
MAX_DISAGREEMENT=0.25
MAX_ENTRY_PRICE=0.85
MIN_ENTRY_PRICE=0.15
MAX_SPREAD=0.03
MIN_ELAPSED_FRAC=0.20
MIN_SECONDS_LEFT_5M=60
MIN_SECONDS_LEFT_15M=120
NEWS_VETO=0.35
MODEL_SHRINK=0.85

# ---------------------------------------------------------------------------
# Exits
# ---------------------------------------------------------------------------
TAKE_PROFIT_PCT=0.15
TAKE_PROFIT_CAPTURE=0.50
MIN_PROFIT_USD=0.10
TAKE_PROFIT_MIN_BID=0.97
STOP_LOSS_PCT=0.60
THESIS_EXIT_PROB=0
FORCE_EXIT_SECONDS=0
# Hard stop: sell once bid <= entry - N cents (e.g. 15). 0 = off. Backtest: 10-20c stops lowered P&L.
FAV_STOP_DROP_CENTS=0
# Time exit: sell any position not at TP with this many seconds left, and never enter inside it. 0 = off.
# Backtest: 120-300s exits cost $0.12-0.40/trade (thin books near expiry).
FAV_EXIT_SECONDS_LEFT=0

# ---------------------------------------------------------------------------
# Risk controls
# ---------------------------------------------------------------------------
MAX_POSITION_PCT=0.02
MAX_POSITION_USD=10
KELLY_FRACTION=0.25
MAX_TOTAL_BTC_EXPOSURE_PCT=0.05
MAX_NET_DIRECTION_PCT=0.04
MAX_OPEN_POSITIONS=2
DAILY_LOSS_LIMIT_PCT=0.05
MAX_DRAWDOWN_PCT=0.10
MAX_CONSECUTIVE_LOSSES=4
MAX_TRADES_PER_DAY=20
COOLDOWN_AFTER_LOSS_SECONDS=600
# Create a file with this name (in the bot folder or data/) to halt and flatten.
KILL_SWITCH_FILE=KILL
# Bookkeeping sanity guard: a bankroll move > BANK_JUMP_PCT with no trade/resolve event sets no new peak and
# skips the drawdown halt until it has persisted BANK_JUMP_WINDOW_SECONDS.
BANK_JUMP_PCT=0.30
BANK_JUMP_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# News / research (RSS works with no keys; APIs are optional extras)
# ---------------------------------------------------------------------------
# RSS_FEEDS=https://cointelegraph.com/rss,https://decrypt.co/feed
CRYPTOPANIC_API_KEY=
NEWSAPI_KEY=
NEWS_REFRESH_SECONDS=120
NEWS_MAX_AGE_SECONDS=600
# Optional LLM headline scorer (any OpenAI-compatible chat completions endpoint). Off by default.
LLM_SCORER_ENABLED=false
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Loop timing
LOOP_SECONDS=5
SCAN_SECONDS=20

# ---------------------------------------------------------------------------
# Local dashboard (dashboard/server.py)
# ---------------------------------------------------------------------------
# Optional: require this token for the dashboard's control endpoints (start/stop/settings).
# Required if you bind the dashboard to anything other than 127.0.0.1.
# DASHBOARD_TOKEN=
# DASHBOARD_PORT=8787
